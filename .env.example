EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional menu fallback origin:
EXPO_PUBLIC_NUTRISLICE_PROXY_URL=https://your-backend.example
# Free key from fdc.nal.usda.gov/api-key-signup; without one the shared DEMO_KEY is used
# and rate limited per IP.
EXPO_PUBLIC_USDA_API_KEY=

# Complete authenticated vision endpoint:
EXPO_PUBLIC_VISION_PROXY_URL=https://your-backend.example/api/vision
# Optional. Defaults to EXPO_PUBLIC_BACKEND_URL + /api/recipe.
# EXPO_PUBLIC_RECIPE_IMPORT_URL=https://your-backend.example/api/recipe
# Public Mapbox token only; never use an sk. secret here:
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.replace_me

# Origin only; HTTPS is required for preview/production.
EXPO_PUBLIC_BACKEND_URL=https://api.example.com

# Build configuration, supplied through EAS environments after project linking:
# EAS_PROJECT_ID=your-real-expo-project-uuid
# Existing remote project slug remains compatible until renamed in the Expo dashboard.
# EXPO_PROJECT_SLUG=calcamp
# EXPO_OWNER=your-expo-account
# IOS_BUNDLE_IDENTIFIER=com.rulocked.app
# ANDROID_PACKAGE=com.rulocked.app

# Phase 6 (empty DSN safely disables runtime crash reporting)
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN belongs in the build environment, never an EXPO_PUBLIC variable.
APP_STORE_CONNECT_APP_ID=
# Public HTTPS pages required before App Store launch; empty values show a friendly notice.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_SUPPORT_URL=
# Configure private App Store Connect upload credentials using EAS credentials.
