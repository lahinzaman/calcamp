{
  "expo": {
    "name": "CalCamp",
    "slug": "calcamp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": [
      "calcamp",
      "rulocked"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101115",
        "foregroundImage": "./assets/brand/mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.WRITE_NUTRITION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101115",
          "image": "./assets/brand/mark.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "react-native-health",
        {
          "healthSharePermission": "Allow CalCamp to read steps, active energy, and recent workouts for activity tracking.",
          "healthUpdatePermission": "Allow CalCamp to save workouts and dietary energy you choose to share."
        }
      ],
      "react-native-health-connect",
      "@rnmapbox/maps",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Use your location to generate a campus walking loop.",
          "locationAlwaysAndWhenInUsePermission": "Allow CalCamp to detect campus arrivals in the background for meal and workout prompts. Your route is not continuously recorded.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-sqlite",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#91ACFF",
          "defaultChannel": "rulocked-reminders",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CalCamp to photograph meals and scan food barcodes.",
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "83bb9069-dd83-4d41-bfa5-a760d7d1c06a"
      }
    },
    "owner": "lahin.zaman",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/83bb9069-dd83-4d41-bfa5-a760d7d1c06a",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
