PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VISION_ALLOWED_ORIGIN=http://localhost:8081
# A LogMeal APIUser token is scoped to one app account. Single-account development:
LOGMEAL_USER_ID=replace-with-supabase-auth-user-uuid
LOGMEAL_API_KEY=replace-with-logmeal-api-user-token
# Multiple accounts: provision independent APIUsers; store mapping only on the server.
# LOGMEAL_USER_TOKENS_JSON={"supabase-user-uuid":"logmeal-api-user-token"}
GOOGLE_PLACES_API_KEY=replace-with-google-places-key
TAKEOUT_PROVIDER=google_places

# Optional campus web CORS origins (defaults to VISION_ALLOWED_ORIGIN).
CAMPUS_ALLOWED_ORIGIN=http://localhost:8081,http://127.0.0.1:8081

# Phase 5 cache freshness (1-3600 seconds); stale fallback lasts one additional hour.
CAMPUS_CACHE_TTL_SECONDS=300
# Set only to verified reverse-proxy subnets, comma separated. Unset trusts none.
# TRUST_PROXY=your-verified-proxy-subnet

# Required by the notification worker AND the web service's authenticated account-deletion route.
# Server only; never copy into the mobile bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Optional/recommended Expo enhanced push-security access token:
EXPO_ACCESS_TOKEN=
