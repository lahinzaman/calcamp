PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VISION_ALLOWED_ORIGIN=http://localhost:8081
# One key serves every signed-in user; nothing is provisioned per account.
OPENAI_API_KEY=replace-with-openai-api-key
# Optional. Defaults to gpt-5.6-terra; set a more capable model to trade cost for accuracy.
# OPENAI_VISION_MODEL=gpt-5.6-sol
# Branded fast food search. A client-credentials token is fetched once and held in memory
# until shortly before it expires, not requested per search.
FATSECRET_CLIENT_ID=replace-with-fatsecret-client-id
FATSECRET_CLIENT_SECRET=replace-with-fatsecret-client-secret

GOOGLE_PLACES_API_KEY=replace-with-google-places-key
TAKEOUT_PROVIDER=google_places

# Optional campus web CORS origins (defaults to VISION_ALLOWED_ORIGIN).
CAMPUS_ALLOWED_ORIGIN=http://localhost:8081,http://127.0.0.1:8081

# Phase 5 cache freshness (1-3600 seconds); stale fallback lasts one additional hour.
CAMPUS_CACHE_TTL_SECONDS=300
# Defaults to 1: one reverse proxy in front, which is what Render provides. Override with an
# exact subnet list, a different hop count, or `false` when nothing proxies this service.
# TRUST_PROXY=your-verified-proxy-subnet

# Required by the notification worker AND the web service's authenticated account-deletion route.
# Server only; never copy into the mobile bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Optional/recommended Expo enhanced push-security access token:
EXPO_ACCESS_TOKEN=
